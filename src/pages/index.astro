---
const base = import.meta.env.BASE_URL;
const logoUrl = `${base}assets/data-flow-original-logo.png`;
const iconUrl = `${base}assets/data-flow-social-icon.png`;
const services = [
  { number:'01', title:'Social Media', description:'Eine Präsenz, die zu deiner Marke passt. Mit Inhalten, Strategie und einem klaren Blick auf deine Zielgruppe.', tag:'CONTENT · STRATEGIE · COMMUNITY' },
  { number:'02', title:'Google Ads', description:'Gezielte Kampagnen statt Streuverlust. Datenbasiert geplant, laufend optimiert und verständlich ausgewertet.', tag:'SEARCH · PERFORMANCE · INSIGHTS' },
  { number:'03', title:'Digitalstrategie', description:'Die richtigen Kanäle, eine klare Positionierung und ein Plan, der zu deinem Unternehmen passt.', tag:'POSITIONIERUNG · BERATUNG · WACHSTUM' }
];
---
<!doctype html>
<html lang="de-CH">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#F8F7F4" />
  <link rel="icon" type="image/png" href={iconUrl} />
  <meta name="description" content="winomedia – Social Media, Google Ads und digitale Strategien mit Klarheit, Kreativität und Fokus auf Wirkung." />
  <title>winomedia — Digital Marketing mit Wirkung</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    :root{--ink:#171717;--gold:#C9A477;--cream:#F8F7F4;--muted:#77736e;--line:#e7e0d7}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:Montserrat,Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button{font:inherit}.wrap{width:min(1160px,calc(100% - 64px));margin:auto}.nav{display:flex;justify-content:space-between;align-items:center;height:92px;border-bottom:1px solid var(--line)}.brand{font-size:26px;letter-spacing:-1.5px}.brand strong{font-weight:800}.brand span{font-weight:400}.navlinks{display:flex;align-items:center;gap:36px;font-size:12px;font-weight:600}.navlinks a:not(.pill):hover{color:#a47b4d}.pill{display:inline-flex;align-items:center;justify-content:center;gap:16px;background:var(--ink);color:#fff;border-radius:999px;padding:17px 25px;font-size:12px;font-weight:700;transition:transform .2s,background .2s}.pill:hover{transform:translateY(-2px);background:#3a3028}.pill.light{background:var(--cream);color:var(--ink)}.eyebrow{font-size:11px;letter-spacing:3px;font-weight:700;text-transform:uppercase;color:#a78358}.hero{padding:116px 0 65px;position:relative}.hero h1{font-size:clamp(50px,7.2vw,104px);line-height:1.08;letter-spacing:-.075em;max-width:1000px;margin:27px 0}.hero h1 em{font-style:normal;color:#b99467}.hero p{font-size:16px;line-height:1.95;color:#69645f;max-width:540px;margin:26px 0 33px}.flow{display:block;width:100%;height:auto}.hero-flow{margin:45px 0 0;opacity:.82}.section{padding:115px 0;border-top:1px solid var(--line)}.section-header{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:58px}.section h2{font-size:clamp(34px,4.2vw,62px);line-height:1.18;letter-spacing:-.055em;margin:18px 0 0;max-width:650px}.aside{max-width:310px;color:var(--muted);font-size:13px;line-height:1.9}.services{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.service{min-height:330px;border:1px solid var(--line);border-radius:20px;padding:32px;display:flex;flex-direction:column;transition:transform .25s,box-shadow .25s}.service:hover{transform:translateY(-5px);box-shadow:0 16px 42px #34220f0b}.service .num{font-size:12px;color:#ad8b61}.service h3{font-size:26px;letter-spacing:-1px;margin:52px 0 12px}.service p{font-size:13px;line-height:1.9;color:#6d6964;margin:0}.tag{margin-top:auto;padding-top:26px;font-size:9px;letter-spacing:1.4px;color:#a9875d;font-weight:700}.about{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}.about p{color:#6d6964;line-height:2;font-size:15px}.art{min-height:340px;border-radius:22px;background:#ede5d9;display:flex;align-items:center;justify-content:center;padding:35px;overflow:hidden}.art svg{width:100%;max-width:400px}.contact{background:#171717;color:#fff;padding:112px 0 60px}.contact .eyebrow{color:#d5b386}.contact h2{font-size:clamp(44px,6vw,82px);letter-spacing:-.065em;line-height:1.15;margin:23px 0}.contact p{max-width:520px;line-height:1.9;color:#b8b5b0;font-size:15px;margin-bottom:35px}.footer{border-top:1px solid #393939;margin-top:100px;padding-top:27px;display:flex;justify-content:space-between;gap:15px;font-size:11px;color:#aaa}.footer a{text-decoration:underline;text-underline-offset:3px}.mini-flow{max-width:380px;margin:28px 0 0}.reveal{animation:rise .75s both}@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}@media(max-width:800px){.wrap{width:min(100% - 38px,1160px)}.nav{height:75px}.navlinks{gap:14px}.navlinks a:not(.pill){display:none}.hero{padding:76px 0 48px}.hero h1{font-size:clamp(48px,11vw,78px)}.hero-flow{margin-top:45px}.section{padding:75px 0}.section-header{display:block}.services,.about{grid-template-columns:1fr}.about{gap:35px}.service{min-height:270px}.service h3{margin-top:35px}.contact{padding-top:80px}.footer{flex-direction:column;margin-top:70px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{animation:none}.service,.pill{transition:none}}
  
    /* Premium editorial refinement */
    body{background:#F8F7F4}
    .wrap{width:min(1200px,calc(100% - 88px))}
    .nav{height:104px}
    .brand-premium{display:flex;align-items:center;gap:0;font-size:22px;letter-spacing:-1.25px}
    .brand-symbol{display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;letter-spacing:-2px;width:52px;height:40px;margin-right:17px;border-right:1px solid #d7c8b7}
    .brand-symbol span,.contact-mark span{color:var(--gold)}
    .navlinks{letter-spacing:.02em}
    .hero{padding-top:132px;padding-bottom:115px}
    .hero h1{font-size:clamp(52px,7.3vw,106px);line-height:1.04;max-width:1100px;margin:32px 0 26px;letter-spacing:-.077em}
    .hero p{max-width:560px;font-size:16px;line-height:1.85}
    .eyebrow-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#C9A477;margin-right:9px;vertical-align:middle}
    .hero-signature{margin-top:100px;background:#fff;border:1px solid #e9e4de;border-radius:6px;padding:27px 35px 25px;box-shadow:0 28px 80px #17171708}
    .hero-signature img{display:block;width:min(100%,1050px);height:auto;margin:48px auto 45px}
    .signature-top,.signature-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px;color:#8c8379;font-size:10px;font-weight:700;letter-spacing:.19em}
    .signature-top{border-bottom:1px solid #efebe6;padding-bottom:19px}
    .signature-bottom{justify-content:center;border-top:1px solid #efebe6;padding-top:20px}
    .sig-line{height:1px;width:35px;background:#c9a477}
    .section{padding:132px 0}
    .service{background:#faf9f7;border-radius:5px;min-height:345px;padding:38px}
    .service h3{font-size:27px}
    .service:hover{border-color:#c9a477}
    .premium-art{background:#eee8df;border-radius:5px;display:flex;flex-direction:column;align-items:stretch;justify-content:space-between;min-height:420px;padding:33px;gap:45px}
    .premium-art img{width:100%;height:auto;mix-blend-mode:multiply}
    .art-kicker,.art-note{font-size:10px;letter-spacing:.19em;font-weight:700;color:#8b7763}
    .art-note{text-align:right}
    .contact{position:relative;overflow:hidden}
    .contact .wrap{position:relative;z-index:1}
    .contact-mark{position:absolute;right:-2%;top:7%;font-size:clamp(150px,28vw,420px);font-weight:800;letter-spacing:-.17em;opacity:.12;line-height:1;pointer-events:none}
    .footer{margin-top:130px}
    @media(max-width:800px){.wrap{width:calc(100% - 40px)}.nav{height:78px}.hero{padding-top:78px;padding-bottom:76px}.hero-signature{margin-top:60px;padding:16px}.hero-signature img{margin:35px auto}.signature-top,.signature-bottom{font-size:8px;letter-spacing:.07em}.sig-line{width:12px}.section{padding:78px 0}.premium-art{min-height:260px}.contact-mark{top:30%;right:-15%}}
  </style>
</head>
<body>
  <header class="wrap nav">
    <a class="brand brand-premium" href="#start" aria-label="winomedia Startseite"><span class="brand-symbol" aria-hidden="true">wm<span>.</span></span><strong>wino</strong><span>media</span></a>
    <nav class="navlinks" aria-label="Hauptnavigation"><a href="#leistungen">Leistungen</a><a href="#ueber">Über winomedia</a><a class="pill" href="#kontakt">Kontakt ↗</a></nav>
  </header>
  <main>
    <section class="wrap hero" id="start">
      <div class="eyebrow reveal"><span class="eyebrow-dot"></span> DIGITAL MARKETING · SCHWEIZ</div>
      <h1 class="reveal">Mehr als sichtbar.<br/><em>Wirkung, die bleibt.</em></h1>
      <p class="reveal">Social Media, Google Ads und digitale Strategien, die nicht nur gut aussehen – sondern etwas bewegen.</p>
      <a class="pill" href="#kontakt">Projekt besprechen <span aria-hidden="true">↗</span></a>
      <div class="hero-signature"><div class="signature-top"><span>01 / BRAND IDENTITY</span><span>THE DATA FLOW</span></div><img src={logoUrl} alt="Originales winomedia Data-Flow-Logo mit schwarz-goldenem WM-Symbol" width="1140" height="180" loading="eager"/><div class="signature-bottom"><span>STRATEGIE</span><span class="sig-line"></span><span>PERFORMANCE</span><span class="sig-line"></span><span>GESTALTUNG</span></div></div>
    </section>
    <section class="section" id="leistungen"><div class="wrap"><div class="section-header"><div><div class="eyebrow">WAS ICH FÜR DICH TUN KANN</div><h2>Gute Ideen.<br/>Messbare Wirkung.</h2></div><p class="aside">Digitales Marketing muss nicht kompliziert sein. Entscheidend ist, dass Strategie, Umsetzung und Resultate zusammenpassen.</p></div><div class="services">{services.map(service=><article class="service"><span class="num">{service.number} / 03</span><h3>{service.title}</h3><p>{service.description}</p><span class="tag">{service.tag}</span></article>)}</div></div></section>
    <section class="section" id="ueber"><div class="wrap about"><div class="art premium-art"><span class="art-kicker">DAS ZEICHEN FÜR BEWEGUNG</span><img src={logoUrl} alt="Das originale Data-Flow-Markenmotiv von winomedia" loading="lazy" width="1140" height="180"/><span class="art-note">WENIGER RAUSCHEN. MEHR WIRKUNG.</span></div><div><div class="eyebrow">PERSÖNLICH. STRATEGISCH. DIGITAL.</div><h2>Marketing mit<br/>Persönlichkeit.</h2><p>Hinter winomedia steckt der Anspruch, digitale Möglichkeiten verständlich und wirkungsvoll einzusetzen. Mit frischen Ideen, einem Auge für Details und einem klaren Fokus auf das, was für dein Unternehmen zählt.</p><p><strong>Hier entsteht bald meine persönliche Vorstellung.</strong> Dieser Abschnitt wird mit deinen Angaben ergänzt.</p></div></div></section>
    <section class="contact" id="kontakt"><div class="wrap"><div class="eyebrow">LET'S CONNECT</div><h2>Bereit, digital<br/>weiterzukommen?</h2><p>Du hast ein Projekt, eine Idee oder möchtest deine Online-Präsenz weiterentwickeln? Ich freue mich auf den Austausch.</p><a class="pill light" href="mailto:DEINE-EMAIL@BEISPIEL.CH?subject=Anfrage%20an%20winomedia">Kontakt aufnehmen ↗</a><div class="contact-mark" aria-hidden="true">wm<span>.</span></div><footer class="footer"><span>© {new Date().getFullYear()} winomedia · Digital Marketing</span><span>Impressum und Datenschutz vor Veröffentlichung ergänzen</span></footer></div></section>
  </main>
</body>
</html>
